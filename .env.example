# Supabase 프로젝트 > Settings > API
SUPABASE_URL=https://xxxx.supabase.co
# service_role 키는 서버에서만 사용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# 세션 서명용 32자 이상 랜덤 문자열: openssl rand -base64 48
SESSION_SECRET=
# 배포 주소(공유 링크 미리보기용). 예: https://crew.example.com
SITE_URL=http://localhost:3000
